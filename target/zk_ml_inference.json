{"noir_version":"1.0.0-beta.21+2160948374c07438764db65440b1fb3b0aa8d517","hash":"5369304879613555093","abi":{"parameters":[{"name":"private_inputs","type":{"kind":"array","length":4,"type":{"kind":"field"}},"visibility":"private"},{"name":"pub_model_weights","type":{"kind":"array","length":4,"type":{"kind":"field"}},"visibility":"private"},{"name":"pub_bias","type":{"kind":"field"},"visibility":"private"},{"name":"pub_expected_activation","type":{"kind":"field"},"visibility":"private"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"use dep::std;\n\nfn main(\n    private_inputs: [Field; 4], \n    pub_model_weights: [Field; 4],\n    pub_bias: Field,\n    pub_expected_activation: Field \n) {\n    let mut accumulator: Field = 0;\n\n    // 1. Compute the ML Dot Product Matrix\n    for i in 0..4 {\n        accumulator += private_inputs[i] * pub_model_weights[i];\n    }\n\n    // 2. Apply network bias\n    accumulator += pub_bias;\n\n    // 3. Safe Type-Cast Activation Check for Field overflow\n    let is_active = (accumulator as u32) > 100;\n\n    // 4. Enforce verifiable state transformation\n    assert(is_active as Field == pub_expected_activation);\n}\n","path":"/root/zk_ml_inference/src/main.nr","function_locations":[{"start":151,"name":"main"}]}}}