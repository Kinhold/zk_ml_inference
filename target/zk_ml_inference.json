{"noir_version":"1.0.0-beta.21+89a0f0faf3a5f1273c8ac4843b7877882437e277","hash":"8120168463498729065","abi":{"parameters":[{"name":"private_inputs","type":{"kind":"array","length":4,"type":{"kind":"field"}},"visibility":"private"},{"name":"model_weights","type":{"kind":"array","length":4,"type":{"kind":"field"}},"visibility":"public"},{"name":"bias","type":{"kind":"field"},"visibility":"public"},{"name":"expected_activation","type":{"kind":"field"},"visibility":"public"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"49":{"source":"fn main(\n    private_inputs: [Field; 4],\n    model_weights: pub [Field; 4],\n    bias: pub Field,\n    expected_activation: pub Field,\n) {\n    let mut accumulator: Field = 0;\n\n    for i in 0..4 {\n        accumulator += private_inputs[i] * model_weights[i];\n    }\n\n    accumulator += bias;\n\n    let is_active = (accumulator as u32) > 100;\n\n    assert(is_active as Field == expected_activation);\n}\n\n#[test]\nfn test_active_score() {\n    main([10, 20, 30, 40], [2, 1, 1, 1], 5, 1);\n}\n\n#[test]\nfn test_inactive_score() {\n    main([10, 20, 30, 40], [1, 0, 0, 0], 5, 0);\n}\n\n#[test]\nfn test_threshold_is_inactive() {\n    main([100, 0, 0, 0], [1, 0, 0, 0], 0, 0);\n}\n\n#[test]\nfn test_one_above_threshold_is_active() {\n    main([101, 0, 0, 0], [1, 0, 0, 0], 0, 1);\n}\n\n#[test(should_fail)]\nfn test_rejects_incorrect_activation() {\n    main([101, 0, 0, 0], [1, 0, 0, 0], 0, 0);\n}\n","path":"/workspace/kinhold-org/zk_ml_inference/src/main.nr","function_locations":[{"start":135,"name":"main"},{"start":426,"name":"test_active_score"},{"start":512,"name":"test_inactive_score"},{"start":605,"name":"test_threshold_is_inactive"},{"start":704,"name":"test_one_above_threshold_is_active"},{"start":815,"name":"test_rejects_incorrect_activation"}]}}}